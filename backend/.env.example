# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database

# Loteria API (comma-separated for fallback)
LOTERIA_API_KEY=your_api_key_1,your_api_key_2

# Server
BASE_URL=http://localhost:8080
PORT=8080

# CORS (comma-separated for multiple origins)
# Production: https://your-app.vercel.app
# Development: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Scheduler (optional, disabled by default)
# Automatically checks draw results from Lotería API
# Uses standard cron expressions (5 fields: minute hour day month weekday)
# Examples:
#   0 6 * * 1       → Every Monday at 06:00
#   0 6,18 * * 1-5  → Weekdays at 06:00 and 18:00
#   @every 30m      → Every 30 minutes
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 6 * * 1
